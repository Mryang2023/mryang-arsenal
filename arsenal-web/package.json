{
  "name": "arsenal-web",
  "version": "0.1.0",
  "private": true,
  "description": "杨先生的军火库 · 前端。一份规则数据，三种出口：人查 / 给 AI 用 / 拿代码验。",
  "scripts": {
    "sync": "node node_modules/tsx/dist/cli.mjs scripts/gen-theme-tokens.ts && node scripts/sync-rules.mjs && node scripts/sync-content.mjs && node scripts/sync-roster.mjs && node scripts/build-scaffold-templates.mjs && node node_modules/tsx/dist/cli.mjs scripts/calc-governance.ts && node scripts/calc-ci-history.mjs && node scripts/calc-consistency.mjs",
    "sync:rules": "node scripts/sync-rules.mjs",
    "sync:content": "node scripts/sync-content.mjs",
    "sync:governance": "node node_modules/tsx/dist/cli.mjs scripts/calc-governance.ts",
    "sync:roster": "node scripts/sync-roster.mjs",
    "sync:ci-history": "node scripts/calc-ci-history.mjs",
    "sync:consistency": "node scripts/calc-consistency.mjs",
    "sync:scaffold": "node scripts/build-scaffold-templates.mjs",
    "gen:rule-schema": "node scripts/gen-rule-schema.mjs",
    "gen:theme-tokens": "node node_modules/tsx/dist/cli.mjs scripts/gen-theme-tokens.ts",
    "gen:theme-tokens:check": "node node_modules/tsx/dist/cli.mjs scripts/gen-theme-tokens.ts --check",
    "schema:rule:check": "node scripts/gen-rule-schema.mjs --check",
    "icons:rasterize": "node scripts/icons-rasterize.mjs",
    "predev": "npm run sync",
    "dev": "node scripts/next-run.mjs dev -p 3010",
    "prebuild": "npm run sync",
    "build": "node scripts/next-run.mjs build",
    "start": "next start -p 3010",
    "preverify": "npm run sync",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "typecheck:verify": "node node_modules/typescript/bin/tsc --noEmit --project .verify/tsconfig.json",
    "verify:arch": "tsx .verify/audit-check.ts",
    "verify:graph": "tsx .verify/graph-check.ts",
    "verify:project": "tsx .verify/project-check.ts",
    "verify:scaffold": "tsx .verify/scaffold-check.ts",
    "verify:charter": "tsx .verify/charter-check.ts",
    "verify:checkup": "tsx .verify/checkup-check.ts",
    "verify:engine": "tsx .verify/run.ts",
    "verify:parity": "tsx .verify/parity-check.ts",
    "verify:with-backend": "node scripts/verify-with-backend.mjs",
    "verify:archify": "tsx .verify/archify-check.ts",
    "verify:scan": "tsx .verify/scan-check.ts",

    "qa:pr": "tsx scripts/qa-pr.mjs",
    "qa:watch": "node scripts/autopsy-watch.mjs once",
    "verify:topology": "tsx .verify/topology-check.ts",
    "verify:visual": "tsx .verify/visual-check.ts",
    "verify:meta": "tsx .verify/meta-check.ts",
    "verify:rules": "node scripts/verify-rules.mjs",
    "verify": "node scripts/verify-all.mjs",
    "verify:cases": "tsx .verify/case-check.ts"
  },
  "dependencies": {
    "next": "16.4.0",
    "prismjs": "^1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.19.2",
    "@types/prismjs": "^1.26.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.4.39",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  }
}
