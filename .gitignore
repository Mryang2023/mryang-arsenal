# ═══════════════════════════════════════════════════════════════
#  杨先生的军火库 —— 仓库边界
#
#  判定原则：能由数据源重新生成的一律不进 Git。
#  进 Git 的是「数据源」：arsenal-rules / arsenal-cookbook / arsenal-stacks /
#  tools/  /  arsenal-web/src  /  arsenal-server/src
# ═══════════════════════════════════════════════════════════════

# ── 依赖与构建产物 ────────────────────────────────────────────
node_modules/
.next/
out/
dist/
build/
target/

# ── 生成物：由 tools/build-content.py + sync-content.mjs 产出 ──
#    重新生成：python tools/build-content.py && cd arsenal-web && node scripts/sync-content.mjs
arsenal-web/src/generated/

# ── 验证产物：脚本本身要提交，跑出来的东西不要 ────────────────
#    .verify/*.ts / *.mjs 是自检代码，属资产；截图与中间 zip 是产物
#    _b_*.mjs 是 tsx 为了解析 tsconfig 路径别名（@/lib/...）生成的临时打包产物，
#    每个入口文件一份、近 900KB，跑一次就变一次 —— 绝不能进仓库。
arsenal-web/.verify/tmp/
arsenal-web/.verify/shots*/
arsenal-web/.verify/_b_*.mjs

# ── 示例导出包：装配台随时可重新导出，不占仓库 ────────────────
arsenal-demo-*.zip

# ── 会话级调试产物：探针输出 / 临时脚本，用完即弃 ──────────────
#    约定：一次性抓取（环境探测、命令日志重定向、临时 runner）一律写
#    到 .workbuddy/_* —— 下划线前缀 = 不是资产，随手可删。
#    注意只匹配下划线开头，.workbuddy/memory/ 不受影响。
#    ⚠️ 必须带 **/ 前缀：` .workbuddy/_*` 中间有斜杠，会被锚定到仓库根，
#    子目录里的 arsenal-web/.workbuddy/ 挡不住（2026-09-20 实测 git check-ignore
#    对 arsenal-web/.workbuddy/_*.png 返回「未忽略」，探针产物会漏进待提交列表）。
**/.workbuddy/_*

# ── 夜跑接力链的瞬时状态文件（2026-09-21 夜跑引入）──────────────
#    .workbuddy/night-chain/ 下每一棒开工/收工都会写状态文件，跑完即弃；
#    但同目录的 REVIEW.md 是给人看的产出，**故意不忽略**。
#    说明见 docs/hy4-night-plans/NIGHT-RUN.md §二。
.workbuddy/night-chain/*-running.json
.workbuddy/night-chain/*-done.json
.workbuddy/night-chain/*-blocked.json

# ── IDE 本地配置：每台机器、每个人都不一样，不进仓库 ──────────
#    JetBrains 会在项目根建 .idea/，VS Code 建 .vscode/
.idea/
*.iml
*.ipr
*.iws
.vscode/

# ── 工具与系统 ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.tsbuildinfo
next-env.d.ts
.DS_Store
Thumbs.db
*.log
npm-debug.log*
*.swp
